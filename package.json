{
  "name": "mapatlas",
  "private": true,
  "version": "0.0.0",
  "description": "MAP-ATLAS: a domain-agnostic engine for interactive field mapping",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "scan:isolation": "node scripts/scan-isolation.mjs",
    "scan:spdx": "node scripts/scan-spdx.mjs",
    "scan": "npm run scan:isolation && npm run scan:spdx",
    "ci": "npm run build && npm run typecheck && npm run lint && npm run test && npm run scan"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
