{
  "name": "mapatlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MAP-ATLAS — domain-agnostic engine for interactive field mapping",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "scan:isolation": "node scripts/check-isolation.mjs",
    "scan:spdx": "node scripts/check-spdx.mjs",
    "scan": "npm run scan:isolation && npm run scan:spdx",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "leaflet": "^1.9.4",
    "pmtiles": "^3.2.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.4"
  }
}
