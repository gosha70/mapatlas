{
  "name": "mapatlas",
  "version": "0.0.0",
  "private": true,
  "description": "Domain-agnostic engine for interactive field mapping",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:isolation": "node scripts/scan-isolation.mjs",
    "scan:spdx": "node scripts/scan-spdx.mjs",
    "check:packaging": "node scripts/check-packaging.mjs",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run test:coverage && npm run scan:isolation && npm run scan:spdx && npm run format:check",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium",
    "fixture:build": "node scripts/fixture/build-fixture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mapbox/vector-tile": "2.0.3",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "d3-contour": "4.0.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "geojson-vt": "4.0.3",
    "globals": "17.11.0",
    "happy-dom": "20.11.13",
    "pbf": "4.0.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "s2-pmtiles": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vt-pbf": "3.1.3"
  }
}
