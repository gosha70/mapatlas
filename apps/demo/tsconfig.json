{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // The demo is a browser app now, not a stub library: `/lab` mounts a map and substitutes
    // `navigator.geolocation`. `@mapatlas/recorder-web` carries the same lib for the same reason.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/recorder-web"
    },
    {
      "path": "../../packages/storage-idb"
    },
    {
      "path": "../../packages/offline-pmtiles"
    },
    {
      "path": "../../packages/maplibre"
    },
    {
      "path": "../../packages/react"
    }
  ],
  "exclude": ["src/**/*.test.ts"]
}
